<?xml version="1.0" encoding="utf-8"?>
<!-- Vidrio aproximado: se usa en el selector de widgets y antes del primer render en bitmap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#14FFFFFF"
                android:startColor="#3DFFFFFF" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.35"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>
