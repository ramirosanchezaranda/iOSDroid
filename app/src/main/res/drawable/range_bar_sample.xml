<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de ejemplo para la vista previa del selector de widgets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="#FFFFD60A" android:startColor="#FF64D2FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
