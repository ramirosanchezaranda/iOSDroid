<?xml version="1.0" encoding="utf-8"?>
<!-- 3×2 (y 4×2): fecha, hora grande y clima actual. -->
<!-- Generado por tools/gen_widget_layouts.py: no editar a mano. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_fallback" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextClock
            android:id="@+id/date"
            style="@style/WidgetText.Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <include
            layout="@layout/widget_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wx_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_wx_sun" />

                <TextView
                    android:id="@+id/temp"
                    style="@style/WidgetText.Temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_temp"
                    android:textSize="20sp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/hilo"
                    style="@style/WidgetText.Tertiary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_hilo"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/condition"
                style="@style/WidgetText.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_condition"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
