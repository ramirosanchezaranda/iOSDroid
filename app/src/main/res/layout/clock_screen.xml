<?xml version="1.0" encoding="utf-8"?>
<!-- Modo reloj / protector de pantalla, vertical: fecha, hora gigante y clima; notificaciones abajo (como el iPhone). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:id="@+id/ss_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/ss_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="30dp">

        <TextClock
            android:id="@+id/ss_date"
            style="@style/ClockText.Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp" />

        <TextClock
            android:id="@+id/ss_time"
            style="@style/ClockText.Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/ss_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ss_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wx_sun" />

            <TextView
                android:id="@+id/ss_temp"
                style="@style/ClockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/sample_temp"
                android:textFontWeight="500"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/ss_condition"
                style="@style/ClockText.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/sample_condition"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ss_detail"
            style="@style/ClockText.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sample_hilo"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/ss_forecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/ss_notifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/ss_exit"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/exit_pill"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="@string/clock_exit"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Con el teléfono bloqueado: tocar abre el desbloqueo (huella, cara o PIN). -->
    <TextView
        android:id="@+id/ss_unlock_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:drawableStart="@drawable/ic_fingerprint"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/clock_unlock_hint"
        android:textColor="#A6FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
