<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2: fecha corta, hora y temperatura. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_fallback" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <TextClock
            android:id="@+id/date"
            style="@style/WidgetText.Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextClock
            android:id="@+id/time"
            style="@style/WidgetText.Time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="64sp"
            android:gravity="start|center_vertical"
            android:textSize="44sp" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wx_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wx_sun" />

                <TextView
                    android:id="@+id/temp"
                    style="@style/WidgetText.Temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/sample_temp"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/hilo"
                    style="@style/WidgetText.Tertiary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/sample_hilo_short"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/condition"
                style="@style/WidgetText.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/sample_condition"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
