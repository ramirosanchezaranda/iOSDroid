<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2: fecha corta, hora y temperatura. -->
<!-- Generado por tools/gen_widget_layouts.py: no editar a mano. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_fallback" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/date_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextClock
                android:id="@+id/date"
                style="@style/WidgetText.Date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:visibility="visible" />

            <TextClock
                android:id="@+id/date_condensed"
                style="@style/WidgetText.Date.Condensed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date_serif"
                style="@style/WidgetText.Date.Serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date_mono"
                style="@style/WidgetText.Date.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date_script"
                style="@style/WidgetText.Date.Script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/date_image"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </FrameLayout>

        <include
            layout="@layout/widget_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wx_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wx_sun" />

                <TextView
                    android:id="@+id/temp"
                    style="@style/WidgetText.Temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_temp"
                    android:textSize="17sp"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:id="@+id/hilo"
                    style="@style/WidgetText.Tertiary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_hilo_short"
                    android:textSize="11sp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/condition"
                style="@style/WidgetText.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_condition"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
